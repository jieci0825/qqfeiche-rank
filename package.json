{
    "name": "qqfeiche-rank",
    "version": "0.0.0",
    "private": true,
    "packageManager": "pnpm@11.4.0",
    "engines": {
        "node": ">=22.18.0"
    },
    "scripts": {
        "dev": "turbo dev",
        "dev:client": "turbo dev --filter=@qqfeiche/client",
        "dev:admin": "turbo dev --filter=@qqfeiche/admin",
        "dev:server": "turbo dev --filter=@qqfeiche/server",
        "build": "turbo build --filter=@qqfeiche/client --filter=@qqfeiche/admin",
        "upload:client-assets": "node --env-file-if-exists=apps/server/.env apps/server/scripts/upload-client-assets.ts",
        "typecheck": "turbo typecheck",
        "start": "pnpm --filter @qqfeiche/server start"
    },
    "devDependencies": {
        "turbo": "^2.11.10"
    }
}
