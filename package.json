{
    "name": "qqfeiche-rank",
    "version": "0.0.0",
    "private": true,
    "packageManager": "pnpm@11.4.0",
    "engines": {
        "node": ">=22.18.0"
    },
    "scripts": {
        "dev": "turbo dev",
        "dev:client": "turbo dev --filter=@qqfeiche/client",
        "dev:admin": "turbo dev --filter=@qqfeiche/admin",
        "dev:server": "turbo dev --filter=@qqfeiche/server",
        "build": "turbo build --filter=@qqfeiche/client --filter=@qqfeiche/admin",
        "typecheck": "turbo typecheck",
        "start": "pnpm --filter @qqfeiche/server start",
        "theme": "pnpm --filter @qqfeiche/client theme && pnpm --filter @qqfeiche/admin theme"
    },
    "devDependencies": {
        "turbo": "^2.11.10"
    }
}
